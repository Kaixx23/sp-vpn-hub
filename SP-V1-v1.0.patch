+  if (/^\s*(<(!doctype|html)|\{)/i.test(t)) return false;
+  if (!/(^|\n)\s*-?\s*(proxies|proxy-providers)\s*:/.test(t)) return false;
+  if (!/(^|\n)\s*(proxy-groups|groups)\s*:/.test(t)) return false;
