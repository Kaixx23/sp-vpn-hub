# ============================================================================
# SP VPN Hub — environment. Copy to .env for local dev, or paste these into
# Netlify → Site configuration → Environment variables for a deploy.
#
# NOTHING in this repo is hardcoded to a particular site, domain or account:
# every customer-facing URL is built from the incoming request's Host header,
# and all storage is chosen from the variables below. That is what makes it
# safe to fork this into a brand-new repo and point a brand-new Netlify site
# at it — see README → "Redeploying from a brand-new repo".
# ============================================================================

# ---------------------------------------------------------------- storage ---
# Where the customer registry lives. Pick ONE.
#
#   Turso (Netlify / Vercel / anywhere serverless)  <- production
TOKEN_STORE_URL=libsql://your-database-name.turso.io
TOKEN_STORE_AUTH_TOKEN=your-turso-auth-token
#
#   Local SQLite file (local dev only — `npm run dev` defaults to this)
# TOKEN_STORE_URL=file:tokens.db
#
#   Cloudflare D1 needs NEITHER of the above: bind the database as `DB` in
#   wrangler.toml and the worker picks it up automatically.
#
# If TOKEN_STORE_URL is unset the store falls back to IN-MEMORY, which loses
# every customer on cold start. The dashboard shows the active backend, so a
# misconfigured deploy reads "memory" instead of "turso" — check it after
# your first deploy.

# -------------------------------------------------------------- reminders ---
REMINDER_CHANNEL=console
# REMINDER_CHANNEL=telegram
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# REMINDER_CHANNEL=webhook
# WEBHOOK_URL=
REMINDER_THRESHOLDS=30,14,7,3,1
